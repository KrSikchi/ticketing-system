# Copy this file to .env  (cp .env.example .env). Every value has a sane default in src/config.js,
# so the system also boots without a .env file. scripts/start-all.js overrides PORT / WORKER_ID per child.

# HTTP port of ONE API instance (start-all launches 3001, 3002, 3003 regardless of this value)
PORT=3001

# Infra (change the host ports here AND in docker-compose.yml if 6379 / 5432 are taken)
REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgres://postgres:pass@localhost:5432/tickets

# Inventory
EVENT_ID=e1
TOTAL_UNITS=200

# Hold = temporary seat lock in Redis (expiry handled by Redis TTL only)
HOLD_TTL_MS=90000
MAX_HOLDS_PER_USER=4
MAX_HOLD_TOTAL_MS=180000

# Mock payment session lifetime (PENDING/FAILED) and how long PAID sessions are kept for the reconciler
PAY_SESSION_TTL_MS=90000
PAID_SESSION_TTL_MS=3600000

# Mock payment gateway behaviour
PAYMENT_DELAY_MS=100            # simulated gateway latency
PAYMENT_FAIL_RATE=0             # 0..1, chance a mock payment fails (try 0.1 for the "10% failure" scenario)
PAYMENT_TIMEOUT_MS=15000        # hold/session TTL extension while a payment is in flight
STUCK_LOCK_MS=15000             # threshold after which reconciler flags a locked PENDING session

# Authentication & proxy settings ("header" is for local dev / loadtest only; use "jwt" in production)
AUTH_MODE=header
JWT_SECRET=
TRUST_PROXY=false

# Per-user and per-IP token bucket rate limiters (evaluated inside Redis with Redis's own clock)
RATE_LIMIT_ENABLED=true
BUCKET_CAPACITY=20
BUCKET_REFILL_PER_SEC=10
IP_BUCKET_CAPACITY=15000
IP_BUCKET_REFILL_PER_SEC=5000

# In-process GET /seats cache TTL (ms)
SEATMAP_CACHE_MS=250

# Consumer name inside the "persisters" consumer group (start-all launches w1 and w2)
WORKER_ID=w1
