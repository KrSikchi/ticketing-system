# Backend routes are root-mounted; Vite strips /api before proxying these requests.
VITE_API_BASE_URL=/api

# Backend enables Socket.IO CORS for browser connections from the Vite client.
VITE_SOCKET_URL=http://localhost:3001

# Backend API instance (backend defaults to port 3001; start-all also exposes 3002/3003).
API_PROXY_TARGET=http://localhost:3001